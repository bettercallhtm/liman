{
  "expo": {
    "name": "Liman",
    "slug": "liman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "liman",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08294A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liman.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.liman.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08294A"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/bildirim-ikonu.png",
          "color": "#C9A961"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "owner": "getdebi",
    "extra": {
      "eas": {
        "projectId": "4947df9e-edfe-40b5-b0cc-b035890033f5"
      }
    }
  }
}
